// Run NVIDIA kernel 7.x compatibility patches after any dpkg operation
// that touches the nvidia-kernel-dkms package source.
// Uses 'dpkg -s' instead of 'dpkg -l' so the hook fires even when the
// package is in half-configured state (iF) after a failed postinst.
DPkg::Post-Invoke {
    "if dpkg -s 'nvidia-kernel-dkms' 2>/dev/null | grep -q 'Package:' && ls /usr/src/nvidia-current-* >/dev/null 2>&1; then echo '[apt-hook] nvidia-kernel-dkms detected — running kernel 7.x patch script...'; /home/sixco/nvidia-patch-kernel7.sh || echo '[apt-hook] WARNING: nvidia-patch-kernel7.sh exited with error'; fi";
};
